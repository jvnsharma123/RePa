# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only, never exposed to client).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Production Configuration (Cloud persistence, multi-user authentication, and storage)
# When configured, RePa securely synchronizes projects, facts, references, figures, and storage files.
# When omitted, RePa seamlessly operates in demo/local guest mode with full client-side state.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay Subscriptions & Payments Configuration
# RAZORPAY_KEY_ID: Razorpay Key ID (e.g., rzp_test_... in Test Mode)
# RAZORPAY_KEY_SECRET: Razorpay Key Secret (server-side only, never exposed to client)
# RAZORPAY_WEBHOOK_SECRET: Webhook Secret from Razorpay Dashboard for signature verification
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional pre-created Razorpay Plan IDs (leave blank to auto-create monthly plans via API)
RAZORPAY_PLAN_RESEARCHER_ID=
RAZORPAY_PLAN_PRO_RESEARCHER_ID=
